# Environment variables Sightglass reads. All are optional.
# Copy to .env if you need any of them. Never commit .env.

# GPT-4o-on-plots baseline (scripts/run_baselines.py). Without it, that baseline is recorded as not run.
OPENAI_API_KEY=

# Data (src/sightglass/data/loader.py)
# Where the converted UCI #447 build lives. Default: data/build/hydraulic
SIGHTGLASS_BUILD=
# Set to 1 to use synthetic cycles instead of the real build (tests and CI only).
SIGHTGLASS_SYNTHETIC=

# Live API (api/main.py)
# Exported site data the API serves cycles from. Default: web/public/data
SIGHTGLASS_WEB_DATA=
# Comma-separated origins allowed by CORS. Default: http://localhost:5173,http://127.0.0.1:5173
SIGHTGLASS_ALLOWED_ORIGIN=
# Requests per minute per client. Default: 30
SIGHTGLASS_RATE_PER_MIN=

# Port scripts/deploy_api.sh serves the API on. Default: 8000
SIGHTGLASS_PORT=

# Website dev server (web/vite.config.ts): port the /api proxy forwards to. Default: 8000
SIGHTGLASS_API_PORT=
