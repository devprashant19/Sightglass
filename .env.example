# Sightglass Environment Variables
# Copy to .env and fill in as needed. Never commit .env to version control!

# Experiment Tracking (optional)
WANDB_API_KEY=
WANDB_PROJECT=sightglass
WANDB_ENTITY=

# Hugging Face (for downloading/publishing models)
HF_TOKEN=

# Baseline Evaluation (for GPT-4o zero-shot on plots)
OPENAI_API_KEY=

# Sightglass Inference API
SIGHTGLASS_CHECKPOINT=
SIGHTGLASS_DEVICE=cpu
SIGHTGLASS_ALLOWED_ORIGIN=http://localhost:5173
SIGHTGLASS_PORT=8000
